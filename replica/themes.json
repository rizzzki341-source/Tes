{
  "_about": "Themes for reviews.py, rewritten for an Indonesian anime-streaming app. Patterns are Python regular expressions matched case-insensitively against the review text. Vocabulary comes from reading the reviews in reviews.csv (informal Indonesian spellings included).",
  "request_patterns": [
    "\\btolong\\b",
    "\\bmohon\\b",
    "\\btambah(in|kan|i)?\\b",
    "\\bditambah(in|kan)?\\b",
    "\\bsemoga\\b",
    "\\bka?lo bisa\\b",
    "\\bkalau bisa\\b",
    "\\bsaran\\b",
    "\\bminta\\b",
    "\\brequest\\b",
    "\\badain\\b",
    "\\bdiadakan\\b",
    "\\bbelum ada\\b",
    "\\bharusnya\\b",
    "\\bseharusnya\\b",
    "\\bplease add\\b"
  ],
  "themes": [
    {"id": "startup", "label": "Tidak bisa masuk: token keamanan, stuck di logo, login ulang terus", "kind": "complaint",
     "patterns": ["\\btoken\\b", "\\b(nge)?st[ua]c?k\\b", "\\blogo\\b", "\\b(gak?|ga|tidak|nggak|gk|tdk) bisa (masuk|buka|di ?buka|login|log ?in)\\b", "\\brelog", "\\blog ?in ulang\\b", "\\blogin (terus|lagi|mulu)\\b", "\\bgagal terhubung\\b", "\\bmasalah jaringan\\b", "\\brestart aplikasi\\b", "\\blogout sendiri\\b"]},
    {"id": "playback", "label": "Video error atau tidak bisa diputar", "kind": "complaint",
     "patterns": ["\\be+r+o+r+\\b", "\\b(gak?|ga|tidak|nggak|gk|tdk) bisa (di ?)?(tonton|putar|nonton|play)\\b", "\\bgabisa (di ?)?(tonton|nonton|putar)\\b", "\\bvideo(nya)? (tidak|gak?|ga|nggak|gk) (bisa|mau|muncul|jalan)\\b", "\\bgagal (memuat|memutar|load)\\b", "\\blayar hitam\\b", "\\bblank\\b"]},
    {"id": "performance", "label": "Buffering, lag dan server lambat", "kind": "complaint",
     "patterns": ["\\bbuffer", "\\bngel[ae]g\\b", "\\blag\\b", "\\blemot\\b", "\\blelet\\b", "\\bloading\\b", "\\bmuter.?muter\\b", "\\bmacet\\b", "\\bpatah.?patah\\b", "\\bserver\\b", "\\blambat\\b", "\\blemod\\b"]},
    {"id": "bugs", "label": "Bug, force close, keluar sendiri", "kind": "complaint",
     "patterns": ["\\b(nge)?bugs?\\b", "\\bforce ?close\\b", "\\bfor close\\b", "\\bkeluar (sendiri|tiba)", "\\btiba.?tiba keluar\\b", "\\bcrash", "\\bbermasalah\\b", "\\bbanyak masalah\\b"]},
    {"id": "ads", "label": "Iklan dan sistem kunci", "kind": "complaint",
     "patterns": ["\\biklan(nya)?\\b", "\\bads?\\b", "\\bkunci(nya)?\\b", "\\bkeys?\\b"]},
    {"id": "catalogue", "label": "Anime, episode atau movie tidak lengkap / hilang", "kind": "complaint",
     "patterns": ["\\b(di)?(per)?lengkap(i|in|kan)?\\b", "\\bkurang lengkap\\b", "\\bhilang\\b", "\\b(gak?|ga|tidak|nggak|gk|belum|blm) ada anime", "\\banime (yang |yg )?(gak?|ga|tidak|nggak|gk|belum|blm) ada\\b", "\\bmovie(nya)?\\b", "\\bfilm(nya)?\\b", "\\banime (lama|jadul|baru)\\b", "\\bdonghua\\b", "\\bepisode(nya)? .{0,25}(kosong|loncat|lompat|kurang)\\b"]},
    {"id": "late_updates", "label": "Update episode telat atau tidak dilanjutkan", "kind": "complaint",
     "patterns": ["\\btelat\\b", "\\bupdate(nya)? (lama|lambat|telat|lelet)\\b", "\\b(lama|lambat|telat) (banget )?(update|up)\\b", "\\b(belum|blm) (di ?)?update\\b", "\\bketinggalan\\b", "\\b(gak?|ga|tidak|nggak|gk) (di ?)?lanjut", "\\bon ?going\\b"]},
    {"id": "notifications", "label": "Notifikasi telat atau tidak muncul", "kind": "complaint",
     "patterns": ["\\bnotif", "\\bpemberitahuan\\b", "\\blonceng\\b"]},
    {"id": "premium", "label": "Premium, harga dan pembayaran", "kind": "complaint",
     "patterns": ["\\bpremium\\b", "\\b(ber)?langganan\\b", "\\bbayar\\b", "\\bmahal\\b", "\\bharga\\b", "\\bqr(is)?\\b", "\\buang\\b", "\\brefund\\b", "\\btop ?up\\b", "\\bbeli\\b"]},
    {"id": "account", "label": "Akun ter-reset, 1 perangkat, dukungan tidak membalas", "kind": "complaint",
     "patterns": ["\\bakun\\b", "\\b(ke|ter)?.?reset\\b", "\\b(1|satu) perangkat\\b", "\\bemail\\b", "\\b(tidak|gak?|ga) di ?bal[ae]s\\b", "\\b(riwayat|history) (hilang|kehapus|terhapus)\\b", "\\blevel\\b", "\\bexp\\b"]},
    {"id": "subtitle", "label": "Subtitle", "kind": "complaint",
     "patterns": ["\\bsub(title|nya)?\\b", "\\bterjemahan\\b", "\\btakarir\\b"]},
    {"id": "quality", "label": "Kualitas atau resolusi video", "kind": "complaint",
     "patterns": ["\\bkualitas\\b", "\\bresolusi\\b", "\\b(360|480|720|1080) ?p?\\b", "\\bhd\\b", "\\bburik\\b", "\\bburam\\b", "\\bpecah\\b"]},
    {"id": "player", "label": "Fitur pemutar: skip opening, kecepatan, layar", "kind": "request",
     "patterns": ["\\bskip (opening|op|intro|ending|ed)\\b", "\\blewati (opening|intro)\\b", "\\bkecepatan\\b", "\\bspeed\\b", "\\blandscape\\b", "\\brotasi\\b", "\\blayar penuh\\b", "\\bfull ?screen\\b", "\\bpip\\b", "\\bpicture in picture\\b", "\\bmini ?player\\b", "\\bauto ?(next|play)\\b", "\\blanjut otomatis\\b", "\\bkecerahan\\b"]},
    {"id": "download", "label": "Unduhan dan tontonan offline", "kind": "request",
     "patterns": ["\\bdownload", "\\bunduh", "\\boffline\\b"]},
    {"id": "social", "label": "Chat, like, clan, pet, mancing (fitur sosial)", "kind": "complaint",
     "patterns": ["\\bchat\\b", "\\blike\\b", "\\bngemis\\b", "\\bclan\\b", "\\bpet\\b", "\\bmancing\\b", "\\bfishing\\b", "\\bgift\\b", "\\btoxic\\b", "\\bkomen(tar|an)?\\b", "\\bteman\\b", "\\bfriends?\\b", "\\bmabar\\b"]},
    {"id": "bloat", "label": "Fitur baru tidak berguna, aplikasi makin berat", "kind": "complaint",
     "patterns": ["\\b(gak?|ga|tidak|nggak|gk) (berguna|penting|perlu)\\b", "\\bkebanyakan (update|fitur|viture)\\b", "\\b(se)?makin (berat|parah|jelek|buruk)\\b", "\\bberat\\b", "\\bmemori\\b", "\\bpenyimpanan\\b", "\\bram\\b", "\\bfokus (ke|di|sama) (anime|nonton)"]},
    {"id": "search", "label": "Pencarian, genre dan navigasi", "kind": "request",
     "patterns": ["\\b(pen)?cari(an)?\\b", "\\bsearch\\b", "\\bfilter\\b", "\\bgenre\\b", "\\bsusah (nyari|dicari|cari)\\b", "\\bkategori\\b"]},
    {"id": "customisation", "label": "Tema, bahasa dan dub", "kind": "request",
     "patterns": ["\\btema\\b", "\\bdark mode\\b", "\\bmode gelap\\b", "\\bbahasa\\b", "\\bdub(bing)?\\b"]}
  ]
}
